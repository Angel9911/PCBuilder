<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}PC Builder Pro{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link rel="stylesheet" href="{{ asset('css/auth_login_registration.css') }}">
    <link rel="stylesheet" href="{{ asset('css/review_summary_modal.css') }}">
    <link rel="stylesheet" href="{{ asset('css/filter_section.css') }}">
    <link rel="stylesheet" href="{{ asset('css/home_page.css') }}">
    <script src="{{ asset('js/home_page.js') }}"></script>
    <!-- <link rel="stylesheet" href="path to css file"> -->
</head>
<body>

{% include 'layout/header.html.twig' %}

<div class="relative z-40">
    {% include 'layout/navigation_bar.html.twig' %}
    <!-- Hardware menu placed here -->
</div>
<main>
    {% block content %}
        <h2 style="color: red; text-align: center">Base template is not found</h2>
    {% endblock %}
</main>

{% include 'layout/footer.html.twig' %}

<script src="{{ asset('js/ui/spinner.js') }}"></script>
<script src="{{ asset('js/ui/errors.js') }}"></script>
<script src="{{ asset('js/ui/mobile_menu_toggle.js') }}"></script>
<script src="{{ asset('js/ui/navigation_bar.js') }}"></script>
<script src="{{ asset('js/component_image_button.js') }}"></script>
<script src="{{ asset('js/ui/offer_template.js') }}"></script>
<script src="{{ asset('js/component_scores_section.js') }}"></script>
<script src="{{ asset('js/new_product_filters.js') }}"></script>
<script src="{{ asset('js/component_specifications.js') }}"></script>
<script src="{{ asset('js/performance_analysis.js') }}"></script>
<script src="{{ asset('js/bottleneck_configurator.js') }}"></script>
<script src="{{ asset('js/configurator.js') }}"></script>
<script src="{{ asset('js/configurator_summary.js') }}"></script>
<script src="{{ asset('js/auth_login_registration.js') }}"></script>
<script src="{{ asset('js/ai_questionnaire.js') }}"></script>
<script src="{{ asset('js/ai_product_field.js') }}"></script>
<script src="{{ asset('js/pc_build_configuration.js') }}"></script>

</body>
</html>
