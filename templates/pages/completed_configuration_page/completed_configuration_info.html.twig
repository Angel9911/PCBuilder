{% extends 'base.html.twig' %}

{% block title %}PC Configuration{% endblock %}

{% block content %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Configuration Header -->
        <div class="bg-gradient-to-r from-indigo-600 to-cyan-500 text-white rounded-xl p-8 mb-8 shadow-lg">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                    <h1 class="text-4xl font-bold mb-2">{{ configuration_name }}</h1>
                    <p class="text-indigo-100 text-lg">Gaming Configuration</p>
                    <div class="flex items-center mt-4 space-x-4">
                        <div class="flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar w-5 h-5 mr-1">
                                <path d="M8 2v4"></path><path d="M16 2v4"></path>
                                <rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path>
                            </svg>
                            <span>{{ configuration_date }}</span>
                        </div>
                    </div>
                </div>
                <div class="text-right">
                    <div class="text-3xl font-bold mb-1">${{ configuration_lowest_price }} - ${{ configuration_highest_price }}</div>
                    <div class="text-indigo-200">estimated total</div>
                </div>
            </div>
        </div>

        <!-- Main Grid Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left Sidebar -->
            <div class="lg:col-span-1">
                <!-- Image -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
                    <img src="{{ pc_case.image_url }}" alt="{{ pc_case.name }}" class="max-h-full max-w-full object-contain p-2">
                </div>

                <!-- Power Usage -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
                    <div class="flex items-center justify-between">
                    <span class="text-gray-600 flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-power w-4 h-4 mr-1">
                            <path d="M12 2v10"></path><path d="M18.4 6.6a9 9 0 1 1-12.77.04"></path>
                        </svg>
                        Power Usage
                    </span>
                        <span class="font-medium text-yellow-600">{{ configuration_total_wattage }}W</span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="space-y-3">
                    <form action="{{ path('get.completed.build', { 'buildId': configuration_id }) }}" method="POST">
                        <button class="w-full bg-gradient-to-r from-fuchsia-500 to-purple-600 text-white px-6 py-4 rounded-xl font-semibold hover:from-fuchsia-600 hover:to-purple-700 transition-all duration-200 flex items-center justify-center shadow-lg hover:shadow-xl">
                            Apply Configuration
                            <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-check-circle w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path>
                            </svg>
                        </button>
                    </form>
                    <a href="{{ path('completed.build') }}" class="w-full bg-gray-100 text-gray-700 px-6 py-3 rounded-xl font-medium hover:bg-gray-200 transition-colors duration-200 flex items-center justify-center">
                        Back to Builds
                        <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-external-link w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Main Details -->
            <div class="lg:col-span-2 space-y-8">
                <!-- Description -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h2 class="text-2xl font-semibold text-gray-900 mb-4">Build Description</h2>
                    <p class="text-gray-600 leading-relaxed">
                        This premium gaming PC delivers exceptional performance for 4K gaming and content creation. Carefully selected components ensure optimal cooling and future upgradeability. Perfect for gamers and professionals who demand the best.
                    </p>
                </div>

                <!-- Technical Specifications -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    <h2 class="text-2xl font-semibold text-gray-900 mb-6">Technical Specifications</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {% include 'pages/completed_configuration_page/completed_config_templates/component_specification_card-template.html.twig' with { icon: 'cpu', label: 'CPU', value: cpu } %}
                        {% include 'pages/completed_configuration_page/completed_config_templates/component_specification_card-template.html.twig' with { icon: 'monitor', label: 'GPU', value: gpu } %}
                        {% include 'pages/completed_configuration_page/completed_config_templates/component_specification_card-template.html.twig' with { icon: 'zap', label: 'Motherboard', value: motherboard } %}
                        {% include 'pages/completed_configuration_page/completed_config_templates/component_specification_card-template.html.twig' with { icon: 'memory-stick', label: 'Memory', value: ram } %}
                        {% include 'pages/completed_configuration_page/completed_config_templates/component_specification_card-template.html.twig' with { icon: 'hard-drive', label: 'Storage', value: storage } %}
                        {% include 'pages/completed_configuration_page/completed_config_templates/component_specification_card-template.html.twig' with { icon: 'power', label: 'Power Supply', value: psu } %}
                        {% include 'pages/completed_configuration_page/completed_config_templates/component_specification_card-template.html.twig' with { icon: 'fan', label: 'CPU Cooler', value: 'Noctua NH-D15 Chromax Black' } %}
                        {% include 'pages/completed_configuration_page/completed_config_templates/component_specification_card-template.html.twig' with { icon: 'box', label: 'PC Case', value: pc_case.name } %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}