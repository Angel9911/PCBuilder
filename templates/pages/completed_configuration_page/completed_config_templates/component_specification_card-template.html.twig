<div class="bg-gradient-to-br from-gray-50 to-white p-4 rounded-lg border border-gray-100 hover:shadow-md transition-shadow">
    <div class="flex items-center mb-2">
        <div class="text-indigo-600 mr-3">
            {% if icon == 'cpu' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-cpu w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                    <rect x="9" y="9" width="6" height="6"></rect>
                    <path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" />
                </svg>
            {% elseif icon == 'monitor' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-monitor w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect width="20" height="14" x="2" y="3" rx="2"></rect>
                    <line x1="8" x2="16" y1="21" y2="21"></line>
                    <line x1="12" x2="12" y1="17" y2="21"></line>
                </svg>
            {% elseif icon == 'zap' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-zap w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
            {% elseif icon == 'memory-stick' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-memory-stick w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M6 19v-3M10 19v-3M14 19v-3M18 19v-3M8 11V9M16 11V9M12 11V9M2 15h20M2 7a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v1.1a2 2 0 0 0 0 3.837V17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-5.1a2 2 0 0 0 0-3.837Z"/>
                </svg>
            {% elseif icon == 'hard-drive' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-hard-drive w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <line x1="22" x2="2" y1="12" y2="12" />
                    <path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
                    <line x1="6" x2="6.01" y1="16" y2="16" />
                    <line x1="10" x2="10.01" y1="16" y2="16" />
                </svg>
            {% elseif icon == 'fan' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-fan w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M10.827 16.379a6.082 6.082 0 0 1-8.618-7.002l5.412 1.45a6.082 6.082 0 0 1 7.002-8.618l-1.45 5.412a6.082 6.082 0 0 1 8.618 7.002l-5.412-1.45a6.082 6.082 0 0 1-7.002 8.618l1.45-5.412Z" />
                    <path d="M12 12v.01" />
                </svg>
            {% elseif icon == 'power' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-power w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M12 2v10" />
                    <path d="M18.4 6.6a9 9 0 1 1-12.77.04" />
                </svg>
            {% elseif icon == 'box' %}
                <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-box w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                    <path d="m3.3 7 8.7 5 8.7-5" />
                    <path d="M12 22V12" />
                </svg>
            {% endif %}
        </div>
        <h3 class="font-semibold text-gray-900">{{ label }}</h3>
    </div>
    <p class="font-medium text-gray-800 mb-1">{{ value }}</p>
</div>