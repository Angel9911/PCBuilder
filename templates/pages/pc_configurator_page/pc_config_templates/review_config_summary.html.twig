<!-- Modal wrapper (initially hidden) -->
<div id="reviewModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-4xl w-full p-6 animate-fadeIn overflow-y-auto max-h-[90vh]">

        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold bg-gradient-to-r from-indigo-700 to-cyan-500 bg-clip-text text-transparent">Tell us about your needs</h2>
            <button id="closeReviewModal" class="text-gray-400 hover:text-gray-500 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Component Summary -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-gradient-to-r from-emerald-50 to-green-50 p-4 rounded-lg border border-emerald-200">
                <div class="flex items-center gap-3 mb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="lucide lucide-cpu h-5 w-5 text-emerald-600">
                        <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                        <rect x="9" y="9" width="6" height="6"></rect>
                        <path d="M15 2v2"></path>
                        <path d="M15 20v2"></path>
                        <path d="M2 15h2"></path>
                        <path d="M2 9h2"></path>
                        <path d="M20 15h2"></path>
                        <path d="M20 9h2"></path>
                        <path d="M9 2v2"></path>
                        <path d="M9 20v2"></path>
                    </svg>
                    <p class="text-sm text-emerald-600 font-medium">Total Cost</p>
                </div>
                <p class="text-2xl font-bold bg-gradient-to-r from-emerald-600 to-green-500 bg-clip-text text-transparent">$2,499.99</p>
            </div>
            <div class="bg-gradient-to-r from-amber-50 to-yellow-50 p-4 rounded-lg border border-amber-200">
                <div class="flex items-center gap-3 mb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="lucide lucide-power h-5 w-5 text-amber-600">
                        <path d="M12 2v10"></path>
                        <path d="M18.4 6.6a9 9 0 1 1-12.77.04"></path>
                    </svg>
                    <p class="text-sm text-amber-600 font-medium">Power Draw</p>
                </div>
                <p class="text-2xl font-bold bg-gradient-to-r from-amber-600 to-yellow-500 bg-clip-text text-transparent">650W</p>
            </div>
            <div class="bg-gradient-to-r from-fuchsia-50 to-purple-50 p-4 rounded-lg border border-fuchsia-200">
                <div class="flex items-center gap-3 mb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="lucide lucide-monitor-smartphone h-5 w-5 text-fuchsia-600">
                        <path d="M18 8V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h8"></path>
                        <path d="M10 19v-3.96 3.15"></path>
                        <path d="M7 19h5"></path>
                        <rect width="6" height="10" x="16" y="12" rx="2"></rect>
                    </svg>
                    <p class="text-sm text-fuchsia-600 font-medium">Graphics</p>
                </div>
                <p class="text-2xl font-bold bg-gradient-to-r from-fuchsia-700 to-purple-600 bg-clip-text text-transparent">RTX 4090</p>
            </div>
        </div>

        <form class="space-y-8">

            <!-- Use Case -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">What will you use this PC for?</label>
                <div class="grid grid-cols-3 gap-2">
                    <button type="button" data-use-case="Gaming" class="use-case-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200">Gaming</button>
                    <button type="button" data-use-case="Video Editing" class="use-case-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200">Video Editing</button>
                    <button type="button" data-use-case="Photo Editing" class="use-case-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200">Photo Editing</button>
                    <button type="button" data-use-case="Development" class="use-case-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200">Development</button>
                    <button type="button" data-use-case="3D modeling" class="use-case-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200">3D Modeling</button>
                    <button type="button" data-use-case="Office work" class="use-case-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200">Office Work</button>
                </div>
            </div>

            <!-- Performance -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Performance Priority</label>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                    <button type="button" data-performance="Performance" class="performance-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200">Best Performance</button>
                    <button type="button" data-performance="Balanced" class="performance-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200">Balanced</button>
                    <button type="button" data-performance="Budget" class="performance-btn px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200">Budget Focused</button>
                </div>
            </div>

            <!-- Specific Requirements -->
            <div>
                <label for="specific-requirements" class="block text-sm font-medium text-gray-700 mb-2">Specific Requirements</label>
                <textarea
                        id="specific-requirements"
                        rows="4"
                        class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-200"
                        placeholder="Tell us about specific software, games, or requirements you have..."
                ></textarea>
            </div>

            <!-- Buttons -->
            <div class="flex justify-end space-x-3">
                <button id="cancelReviewModal" type="button" class="inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-gradient-to-r from-slate-50 to-white hover:from-indigo-50 hover:to-cyan-50 text-slate-700 hover:text-slate-800 border border-slate-200 hover:border-slate-300 focus:ring-slate-400 shadow-sm hover:shadow px-4 py-2 text-sm">Cancel</button>
                <button id="submit-review" type="submit" class="px-6 py-2 rounded-lg text-sm font-medium transition-all duration-200 bg-gradient-to-r from-fuchsia-500 to-purple-600 hover:from-fuchsia-600 hover:to-purple-700 text-white shadow-md hover:shadow-lg" disabled>Get AI Recommendations</button>
            </div>
        </form>
    </div>
</div>
