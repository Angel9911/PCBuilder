<section id="how-it-works" class="py-20 px-4 bg-gradient-to-b from-white to-gray-50 overflow-hidden">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-16 opacity-0 translate-y-6 transition-all duration-700" data-animate="fade-up">
            <div class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-cyan-500 to-blue-500 shadow-lg mb-6">
                <i data-lucide="sparkles" class="w-5 h-5 text-white"></i>
                <span class="text-white text-sm font-bold tracking-wide">STEP BY STEP PROCESS</span>
            </div>

            <h2 class="text-4xl md:text-6xl font-bold mb-6">
        <span class="bg-gradient-to-r from-cyan-600 via-blue-600 to-indigo-600 bg-clip-text text-transparent">
          How It Works
        </span>
            </h2>

            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                Build your perfect PC in four comprehensive steps with intelligent guidance and validation
            </p>
        </div>

        <!-- Steps Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {% set steps = [
                {
                    icon: 'sparkles',
                    title: 'Build Your Configuration',
                    description: 'Start building through AI questionnaire, text input, or manual component selection. Our system adapts to your expertise level.',
                    color: 'cyan',
                    gradient: 'from-cyan-500 to-cyan-600',
                    bg: 'from-cyan-50 to-cyan-100',
                    ring: 'ring-cyan-500'
                },
                {
                    icon: 'cpu',
                    title: 'Select Compatible Components',
                    description: 'Choose from verified components with real-time compatibility validation. AI mode provides perfectly matched recommendations.',
                    color: 'blue',
                    gradient: 'from-blue-500 to-blue-600',
                    bg: 'from-blue-50 to-blue-100',
                    ring: 'ring-blue-500'
                },
                {
                    icon: 'shield',
                    title: 'Review Performance',
                    description: 'Analyze your build with bottleneck calculations and FPS estimates. Get AI suggestions for optimization.',
                    color: 'indigo',
                    gradient: 'from-indigo-500 to-indigo-600',
                    bg: 'from-indigo-50 to-indigo-100',
                    ring: 'ring-indigo-500'
                },
                {
                    icon: 'save',
                    title: 'Save & Share',
                    description: 'Save your configuration, share with community, or browse thousands of completed builds to clone and customize.',
                    color: 'purple',
                    gradient: 'from-purple-500 to-purple-600',
                    bg: 'from-purple-50 to-purple-100',
                    ring: 'ring-purple-500'
                }
            ] %}

            {% for step in steps %}
                <div class="relative group opacity-0 translate-y-10 transition-all duration-700" data-animate="fade-up" data-delay="{{ loop.index0 * 150 }}">
                    <!-- Step Badge -->
                    <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 z-10 scale-0 transition-transform duration-700" data-animate="scale-in" data-delay="{{ loop.index0 * 150 + 300 }}">
                        <div class="w-16 h-16 rounded-full bg-gradient-to-r {{ step.gradient }} flex items-center justify-center shadow-xl border-4 border-white ring-4 {{ step.ring }} ring-opacity-30">
                            <span class="text-white font-bold text-2xl">{{ loop.index }}</span>
                        </div>
                    </div>

                    <!-- Card -->
                    <div class="bg-white rounded-2xl p-6 pt-16 border-2 border-gray-100 hover:border-gray-200 hover:shadow-xl transition-all duration-300 h-full relative overflow-hidden">
                        <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b {{ step.bg }} opacity-30 group-hover:opacity-50 transition-opacity"></div>

                        <div class="relative">
                            <div class="inline-flex p-4 rounded-xl bg-gradient-to-r {{ step.gradient }} mb-4 shadow-md">
                                <i data-lucide="{{ step.icon }}" class="w-7 h-7 text-white"></i>
                            </div>

                            <h3 class="text-xl font-bold text-gray-900 mb-3">{{ step.title }}</h3>
                            <p class="text-gray-600 text-sm leading-relaxed">{{ step.description }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>