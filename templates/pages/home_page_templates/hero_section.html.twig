<section id="hero-carousel" class="relative overflow-hidden h-[600px] z-0">
    <div id="hero-slides" class="absolute inset-0 w-full h-full z-10"></div>

    <!-- Navigation buttons -->
    <button id="hero-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-30 p-3 rounded-full bg-white/10 border border-white/30 backdrop-blur-md hover:bg-white/20 transition">
        <i data-lucide="chevron-left" class="w-6 h-6 text-white"></i>
    </button>

    <button id="hero-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-30 p-3 rounded-full bg-white/10 border border-white/30 backdrop-blur-md hover:bg-white/20 transition">
        <i data-lucide="chevron-right" class="w-6 h-6 text-white"></i>
    </button>

    <!-- Slide indicators -->
    <div id="hero-dots" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex space-x-2 z-30"></div>
</section>