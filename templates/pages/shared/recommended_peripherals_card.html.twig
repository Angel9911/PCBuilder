{# pages/shared/recommended_peripherals_card.html.twig #}
{% set periphery = item %}

<div class="relative transform transition-all duration-700 translate-y-0 opacity-100 scale-100"
     style="transition-delay: {{ (global_index * 100) }}ms;">
        {# {% set main_image = periphery.image_url|default('/assets/images/placeholder_product.jpg') %}  #}

        {# Rank-based accent (matches your design) #}
    {% set rank = global_index + 1 %}

    {% set isFirst  = rank == 1 %}
    {% set isSecond = rank == 2 %}
    {% set isThird  = rank == 3 %}

        {% set ringClass =
            isFirst  ? 'shadow-2xl shadow-yellow-500/30 ring-4 ring-yellow-400/50' :
            (isSecond ? 'shadow-xl shadow-gray-400/20 ring-2 ring-gray-400/30' :
            (isThird  ? 'shadow-xl shadow-amber-600/20 ring-2 ring-amber-400/30' : 'shadow-sm'))
        %}

        {% set hoverGlow =
            isFirst  ? 'from-yellow-400 via-yellow-500 to-yellow-600' :
            (isSecond ? 'from-gray-400 via-gray-500 to-gray-600' :
            (isThird  ? 'from-amber-400 via-amber-500 to-amber-600' : 'from-indigo-500 via-purple-500 to-cyan-500'))
        %}

        <div class="relative transform transition-all duration-700 translate-y-0 opacity-100 scale-100" style="transition-delay: {{ (global_index * 100) }}ms;">
            {# Corner badge (crown/medal/trophy) #}
            <div class="absolute -top-3 -left-3 z-20">
                {% if isFirst %}
                    <div class="flex items-center justify-center w-12 h-12 rounded-full shadow-lg border-2 border-white bg-gradient-to-r from-yellow-400 to-yellow-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-crown w-6 h-6 text-yellow-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"></path></svg>
                    </div>
                {% elseif isSecond %}
                    <div class="flex items-center justify-center w-12 h-12 rounded-full shadow-lg border-2 border-white bg-gradient-to-r from-gray-300 to-gray-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-medal w-6 h-6 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M7.21 15 2.66 7.14a2 2 0 0 1 .13-2.2L4.4 2.8A2 2 0 0 1 6 2h12a2 2 0 0 1 1.6.8l1.6 2.14a2 2 0 0 1 .14 2.2L16.79 15"></path>
                            <path d="M11 12 5.12 2.2"></path><path d="m13 12 5.88-9.8"></path><path d="M8 7h8"></path><circle cx="12" cy="17" r="5"></circle><path d="M12 18v-2h-.5"></path>
                        </svg>
                    </div>
                {% elseif isThird %}
                    <div class="flex items-center justify-center w-12 h-12 rounded-full shadow-lg border-2 border-white bg-gradient-to-r from-amber-400 to-amber-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-trophy w-6 h-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                            <path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                            <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                            <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
                        </svg>
                    </div>
                {% endif %}
            </div>

            {# Match pill (top-right) #}
            {% if periphery.ai_matching is defined %}
                <div class="absolute top-3 right-3 z-20">
                    <div class="bg-gradient-to-r from-green-500 to-emerald-600 text-white px-3 py-1.5 rounded-full text-xs font-bold shadow-lg border border-white/50">
                        {{ periphery.ai_matching }}% Match
                    </div>
                </div>
            {% endif %}

            <div class="
            bg-white rounded-xl overflow-hidden group relative
            transition-all duration-500 hover:scale-105
            {{ ringClass }}
          ">
                <div class="
              absolute inset-0 rounded-xl opacity-0 group-hover:opacity-100
              transition-opacity duration-500 pointer-events-none
              bg-gradient-to-r {{ hoverGlow }}
              animate-pulse
            ">
                    <div class="absolute inset-[2px] rounded-xl bg-white"></div>
                </div>

                <div class="relative z-10">
                    {# Image + ribbons #}
                    <div class="relative">
                        <img src="{{ main_image }}" alt="{{ periphery.name }}" class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500">

                        {% if isFirst %}
                            <div class="absolute inset-0 bg-gradient-to-t from-yellow-500/30 to-transparent">
                                <div class="absolute bottom-3 left-3 right-3">
                                    <div class="bg-yellow-500/95 text-white px-2 py-1 rounded-full text-xs font-bold text-center animate-pulse">🏆 BEST MATCH</div>
                                </div>
                            </div>
                        {% endif %}

                        {% if periphery.promo is defined and periphery.promo %}
                            <div class="absolute top-3 left-3 bg-gradient-to-r from-red-500 to-red-600 text-white px-3 py-1 rounded-lg shadow-xl transform -rotate-3 hover:rotate-0 transition-transform duration-300">
                                <span class="text-sm font-bold">PROMO</span>
                            </div>
                        {% endif %}

                        {# Always show IN STOCK bottom-left for this AI section #}
                        <div class="absolute bottom-3 left-3 px-3 py-1.5 rounded-lg shadow-lg text-xs font-bold bg-gradient-to-r from-green-500 to-green-600 text-white border border-white/50">
                            IN STOCK
                        </div>
                    </div>

                    <div class="p-6">
                        {# AI note block #}
                        {% if periphery.ai_description is defined %}
                            <div class="mb-4 p-3 rounded-lg border-2
                      {{ isFirst ? 'bg-gradient-to-r from-yellow-50 to-amber-50 border-yellow-200'
                            : 'bg-gradient-to-r from-indigo-50 to-purple-50 border-indigo-200' }}">
                                <div class="flex items-start gap-2">
                                    <div class="p-1 rounded-full {{ isFirst ? 'bg-yellow-200' : 'bg-indigo-200' }}">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-sparkles w-3 h-3 {{ isFirst ? 'text-yellow-700' : 'text-indigo-700' }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="text-xs font-bold mb-1 {{ isFirst ? 'text-yellow-800' : 'text-indigo-800' }}">
                                            {{ isFirst ? '🏆 TOP AI RECOMMENDATION:' : '🤖 AI MATCH #' ~ rank ~ ':' }}
                                        </p>
                                        <p class="text-xs leading-relaxed {{ isFirst ? 'text-yellow-700' : 'text-indigo-700' }}">
                                            {{ periphery.ai_description }}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        {# Brand / Model #}
                        <div class="mb-3">
                            <span class="text-sm text-blue-600 font-medium">{{ periphery.brand_name }}</span>
                            <h3 class="text-lg font-semibold text-gray-900 mt-1 leading-tight">{{ periphery.name }}</h3>
                        </div>

                        {# Short description (your field) #}
                        <div class="mb-4">
                            <p class="text-gray-600 text-sm mb-3 line-clamp-2">{{ periphery.description }}</p>

                            {# Specs (use your existing mapping) #}
                            <ul class="space-y-2">
                                {% for label, value in periphery.specifications %}
                                    {% set iconConfig = periphery_type_icons[label]|default(null) %}
                                    <li class="flex items-center text-sm text-gray-700">
                                        <div class="w-8 h-8 rounded-lg mr-3 flex items-center justify-center
                                                {{ iconConfig.bgClass|default('bg-gray-100') }}
                                                {{ iconConfig.textClass|default('text-gray-600') }}">
                                            <img src="/assets/images/periphery/{{ iconConfig.icon|default('default_icon.png') }}"
                                                 class="w-full h-full object-contain" alt="{{ label }}">
                                        </div>
                                        {{ value }}
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>

                        {# Ratings (placeholder style preserved) #}
                        <div class="mb-4">
                            <div class="flex items-center gap-1">
                                {% for i in 1..5 %}
                                    {% if i <= 4 %}
                                        <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-star w-4 h-4 text-yellow-400 fill-yellow-400" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                    {% else %}
                                        <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-star w-4 h-4 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                    {% endif %}
                                {% endfor %}
                                <span class="text-sm text-gray-600 ml-1">(4.8)</span>
                            </div>
                        </div>

                        {# Price (replace with your real fields if you have them) #}
                        <div class="mb-4">
                            <div class="flex items-center gap-2">
                                <span class="text-2xl font-bold text-gray-900">$20</span>
                                <span class="text-lg text-gray-500 line-through">$50</span>
                            </div>
                        </div>

                        {# CTA matches the design (gold for #1, blue for others) #}
                        <button class="w-full px-4 py-3 rounded-lg font-semibold text-white transition-all duration-300 transform hover:scale-105
                               {{ isFirst
                        ? 'bg-gradient-to-r from-yellow-500 to-yellow-600 hover:from-yellow-600 hover:to-yellow-700 shadow-lg hover:shadow-yellow-500/30 animate-pulse hover:animate-none'
                        : 'bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-700 hover:to-cyan-600 shadow-md hover:shadow-lg' }}">
                            {{ isFirst ? '🏆 Choose Best Match' : 'Add to Cart' }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
</div>