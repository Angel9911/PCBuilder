{# ===================================================
   Reusable AI Recommendations Section
   Context variables:
   - title (string)
   - subtitle (string)
   - items (array)
   - type ('config' | 'component' | 'peripheral')
=================================================== #}

<div class="relative bg-gradient-to-br from-indigo-50/80 via-purple-50/60 to-cyan-50/80 rounded-2xl p-1 shadow-xl border border-indigo-200/50 backdrop-blur-sm">
    <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-indigo-400 via-purple-500 to-cyan-400 opacity-20 animate-pulse"></div>

    <div class="relative bg-white/90 backdrop-blur-sm rounded-xl p-6 border border-white/50">

        {# === Header === #}
        <div class="bg-gradient-to-r from-indigo-600 via-purple-600 to-cyan-500 rounded-2xl p-6 shadow-lg flex flex-col sm:flex-row justify-between items-center mb-8">
            <div class="flex items-center space-x-4">
                <div class="p-3 bg-white/20 rounded-xl backdrop-blur-sm animate-pulse">
                    <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-sparkles w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                        <path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>
                    </svg>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-white mb-1">{{ title }}</h2>
                    <p class="text-white/90 text-sm">{{ subtitle }}</p>
                </div>
            </div>

            {# Pagination Controls #}
            <div class="flex items-center space-x-3 mt-4 sm:mt-0">
                <button class="p-3 bg-white/20 hover:bg-white/30 rounded-full transition-all duration-200 backdrop-blur-sm" id="prev-slide">
                    <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-arrow-left w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
                    </svg>
                </button>
                <span id="slide-counter" class="text-white font-semibold text-lg">1 / {{ (items|length / 3)|round(0, 'ceil') }}</span>
                <button class="p-3 bg-white/20 hover:bg-white/30 rounded-full transition-all duration-200 backdrop-blur-sm" id="next-slide">
                    <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-arrow-right w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                    </svg>
                </button>
            </div>
        </div>

        {% set pageSize = 3 %}
        {% set global_index = 0 %}
        <div class="relative overflow-hidden">
            <div id="recommendation-track" class="flex transition-transform duration-700 ease-in-out">
                {% for chunk in items|batch(pageSize, null) %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full flex-shrink-0">
                        {% for item in chunk %}
                            {% if item is not null %}
                                {% set templatePath =
                                    type == 'component' ? 'pages/shared/recommended_component_card.html.twig' :
                                    (type == 'peripheral' ? 'pages/shared/recommended_peripherals_card.html.twig' :
                                    'pages/shared/recommended_config_card.html.twig')
                                %}
                                {% include templatePath with {
                                    item: item,
                                    type: type,
                                    main_image: main_image,
                                    periphery_type_icons: periphery_type_icons,
                                    global_index: global_index
                                } %}

                                {# increment ONLY when we actually rendered an item #}
                                {% set global_index = global_index + 1 %}

                            {% endif %}
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>