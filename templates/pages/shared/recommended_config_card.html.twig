<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1 group flex flex-col justify-between">

    <!-- get ai recommendations array -->
    {% if item.ai_recommendation is defined %}
        {% set ai_recommendatios = item.ai_recommendation %}
    {% endif %}

    <!-- Gradient Header -->
    <div class="bg-gradient-to-r from-indigo-600 to-cyan-500 px-6 py-4 flex justify-between items-center">
        <h3 class="text-xl font-bold text-white">{{ item.name }}</h3>
        {% if item.rating is defined %}
            <div class="flex items-center space-x-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-star w-5 h-5 text-yellow-400 fill-yellow-400" viewBox="0 0 24 24">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                <span class="text-white font-semibold">{{ item.rating }}</span>
            </div>
        {% endif %}
    </div>

    <!-- Image -->
    <div class="relative overflow-hidden">
        {% set pc_case = item.components.pc_case ?? null %}

        {% if pc_case %}

        <img src="{{ pc_case.image_url }}" alt="{{ pc_case.name }}" class="w-full h-48 object-contain p-2 transition-transform duration-300 group-hover:scale-105">
        <div class="absolute inset-0 bg-black bg-opacity-30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <button class="px-4 py-2 bg-white bg-opacity-90 text-gray-800 rounded-lg font-medium hover:bg-opacity-100 transition-all duration-200">View Details</button>
        </div>
        {% endif %}
    </div>

    <div class="p-6 flex flex-col justify-between flex-grow">
        <!-- Optional AI Description -->
        {% if ai_recommendatios.ai_summary is defined %}
            <div class="pt-4 mb-4"> {# ← added mb-4 for vertical spacing #}
                <div class="relative bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-indigo-500 p-4 rounded-lg shadow-sm">
                    <div class="flex items-start space-x-3">
                        <p class="text-sm text-indigo-900 leading-relaxed flex-1">
                            {{ ai_recommendatios.ai_summary }}
                        </p>
                        <div class="flex-shrink-0">
                            <div class="flex items-center space-x-1 bg-indigo-600 text-white px-2 py-1 rounded-full text-xs font-bold shadow-md">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="lucide lucide-sparkles w-3 h-3"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
                                    <path d="M5 3v4" />
                                    <path d="M19 17v4" />
                                    <path d="M3 5h4" />
                                    <path d="M17 19h4" />
                                </svg>
                                <span>AI</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Component Specs (optional based on type) -->
        {% if type == 'config' %}
            <div class="space-y-2 mb-4">
                {% set cpu = item.components.cpu ?? null %}

                {% if cpu %}
                    <div class="flex items-center text-gray-700">
                        <div class="text-indigo-600 mr-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-cpu w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                                <rect x="9" y="9" width="6" height="6"></rect>
                                <path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2" />
                            </svg>
                        </div>
                        <span class="text-sm"><span class="font-medium">CPU:</span> {{ cpu.name }}</span>
                    </div>
                {% endif %}

                {% set gpu = item.components.gpu ?? null %}

                {% if gpu %}
                    <div class="flex items-center text-gray-700">
                        <div class="text-indigo-600 mr-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-monitor w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <rect width="20" height="14" x="2" y="3" rx="2"></rect>
                                <line x1="8" x2="16" y1="21" y2="21"></line>
                                <line x1="12" x2="12" y1="17" y2="21"></line>
                            </svg>
                        </div>
                        <span class="text-sm"><span class="font-medium">GPU:</span> {{ gpu.name }}</span>
                    </div>
                {% endif %}

                {% set motherboard = item.components.motherboard ?? null %}

                {% if motherboard %}
                    <div class="flex items-center text-gray-700">
                        <div class="text-indigo-600 mr-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-motherboard w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                                <path d="M11 9h4a2 2 0 0 0 2-2V3"></path>
                                <circle cx="9" cy="9" r="2"></circle>
                                <path d="M7 21v-4a2 2 0 0 1 2-2h4"></path>
                                <circle cx="15" cy="15" r="2"></circle>
                            </svg>
                        </div>
                        <span class="text-sm"><span class="font-medium">Motherboard:</span> {{ motherboard.name }}</span>
                    </div>
                {% endif %}
            </div>



            {% if ai_recommendatios.bottleneck_percentage is defined %}
                <div class="bg-gradient-to-br from-gray-50 to-blue-50 rounded-xl p-4 mb-4 border border-gray-200 shadow-sm space-y-3">
                        <div>
                            <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-gray-700 font-medium flex items-center">
             Bottleneck
          </span>
                                <span class="text-sm font-bold text-amber-600">{{ ai_recommendatios.bottleneck_percentage }}%</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2.5">
                                <div class="h-2.5 bg-gradient-to-r from-amber-400 to-amber-600 rounded-full" style="width: {{ ai_recommendatios.bottleneck_percentage }}%"></div>
                            </div>
                        </div>

                    {% if ai_recommendatios.bottleneck_percentage is defined %}
                        <div>
                            <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-gray-700 font-medium flex items-center">
             Compatibility Score <!-- Maybe at some moment would be Performance score-->
          </span>
                                <span class="text-sm font-bold text-emerald-600">{{ ai_recommendatios.bottleneck_percentage }}%</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2.5">
                                <div class="h-2.5 bg-gradient-to-r from-emerald-400 to-emerald-600 rounded-full" style="width: {{ ai_recommendatios.bottleneck_percentage }}%"></div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}

        <!-- Key Stats -->
        <div class="bg-gray-50 rounded-lg p-3 mb-4">
            <div class="grid grid-cols-1 gap-2 text-sm">
                <div class="flex items-center justify-between">
                        <span class="text-gray-600 flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-power w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path d="M12 2v10"></path>
                                <path d="M18.4 6.6a9 9 0 1 1-12.77.04"></path>
                            </svg>
                            Power Usage:
                        </span>
                    <span class="font-medium text-yellow-600">{{ item.totalWattage }}W</span>
                </div>
            </div>
        </div>

        <!-- Price and Date Row -->
        <div class="flex flex-wrap items-center justify-between mb-4 space-y-2 sm:space-y-0">
            <div class="flex items-center text-gray-600 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-calendar w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M8 2v4M16 2v4M3 10h18"></path>
                    <rect width="18" height="18" x="3" y="4" rx="2"></rect>
                </svg>
                {{ item.createdAt|date('Y-m-d') }}
            </div>
            <div class="text-right text-sm">
                <div class="text-lg sm:text-xl font-bold bg-gradient-to-r from-fuchsia-700 to-purple-600 bg-clip-text text-transparent">
                    ${{ item.lowestPrice }} - ${{ item.highestPrice }}
                </div>
                <div class="text-gray-500">estimated</div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="space-y-2">
            <form action="{{ path('get.completed.build', { 'buildId': item.id }) }}" method="POST">
                <button class="w-full bg-gradient-to-r from-fuchsia-500 to-purple-600 text-white px-4 py-3 rounded-lg font-medium hover:from-fuchsia-600 hover:to-purple-700 transition-all duration-200 flex items-center justify-center">
                    Apply Configuration
                    <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-chevron-right w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                </button>
            </form>
            <button onclick="navigateToBuild('{{ path('completed.build.details', { 'buildId': item.id }) }}')" class="w-full bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium hover:bg-gray-200 transition-colors duration-200 flex items-center justify-center">
                View Full Details
                <svg xmlns="http://www.w3.org/2000/svg" class="lucide lucide-external-link w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M15 3h6v6"></path>
                    <path d="M10 14 21 3"></path>
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                </svg>
            </button>
        </div>

    </div>
</div>
<script>
    function navigateToBuild(url) {
        window.location.href = url;
    }
</script>