<div class="mb-6">
    <h3 class="text-base font-semibold text-gray-900 mb-3 flex items-center">
        <i data-lucide="dollar-sign" class="w-4 h-4 mr-2 text-green-600"></i>
        Budget Priority
    </h3>

    <div class="flex flex-wrap gap-3">
        <!-- 💰 Budget-Friendly -->
        <div
                class="budget-option flex-1 min-w-[180px] p-3 rounded-lg border-2 cursor-pointer transition-all duration-200
                   border-gray-200 hover:border-green-300"
                data-value="budget">
            <div class="flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="p-2 rounded-lg bg-gray-50">
                    <i data-lucide="wallet" class="w-5 h-5 text-emerald-600"></i>
                </div>
                <div>
                    <div class="font-medium text-sm text-gray-900">Budget-Friendly</div>
                    <div class="text-xs text-gray-500">Best value for money</div>
                </div>
            </div>
                <!-- ✅ Add this empty checkmark container -->
                <div class="checkmark w-5 h-5 rounded-full items-center justify-center hidden"></div>
            </div>
        </div>

        <!-- ⚙️ Performance First -->
        <div
                class="budget-option flex-1 min-w-[180px] p-3 rounded-lg border-2 cursor-pointer transition-all duration-200
         border-gray-200 hover:border-green-300"
                data-value="performance">

            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="p-2 rounded-lg bg-gray-50">
                        <i data-lucide="gauge" class="w-5 h-5 text-orange-600"></i>
                    </div>
                    <div>
                        <div class="font-medium text-sm text-gray-900">Performance First</div>
                        <div class="text-xs text-gray-500">Maximum performance</div>
                    </div>
                </div>

                <!-- ✅ Add this empty checkmark container -->
                <div class="checkmark w-5 h-5 rounded-full items-center justify-center hidden"></div>
            </div>
        </div>

        <!-- ⚖️ Balanced -->
        <div
                class="budget-option flex-1 min-w-[180px] p-3 rounded-lg border-2 cursor-pointer transition-all duration-200
         border-gray-200 hover:border-green-300"
                data-value="balanced">
           <div class="flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="p-2 rounded-lg bg-gray-50">
                    <i data-lucide="scale" class="w-5 h-5 text-blue-600"></i>
                </div>
                <div>
                    <div class="font-medium text-sm text-gray-900">Balanced</div>
                    <div class="text-xs text-gray-500">Perfect balance</div>
                </div>
            </div>
               <!-- ✅ Add this empty checkmark container -->
               <div class="checkmark w-5 h-5 rounded-full items-center justify-center hidden"></div>
           </div>
        </div>
    </div>
</div>