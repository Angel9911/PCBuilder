{% for component in components %}
    <div class="bg-white rounded-lg shadow-sm overflow-hidden transition-shadow duration-300 hover:shadow-lg">
        <div class="relative overflow-hidden">
            <img src="https://images.pexels.com/photos/1432675/pexels-photo-1432675.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1260&amp;h=750&amp;dpr=1"
                 alt="{{ component.name }}" class="w-full h-48 object-cover transition-transform duration-300 hover:scale-110">
            <div class="absolute top-2 right-2 flex space-x-2">
                <div class="bg-white rounded-full p-1.5 shadow-sm">
                    <svg class="lucide lucide-star h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg"
                         width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                </div>
            </div>
        </div>
        <div class="p-4">
            <h3 class="text-lg font-semibold bg-gradient-to-r from-indigo-700 to-cyan-500 bg-clip-text text-transparent mb-2">
                {{ component.name }}
            </h3>
            <div class="space-y-2 mb-4">
                {% for label, value in component.specifications %}
                    <div class="flex items-center text-sm text-gray-600">
                        <span class="capitalize min-w-[140px]">{{ label }}:</span>
                        <span class="ml-1 font-medium">{{ value }}</span>
                    </div>
                {% endfor %}
            </div>
            <div class="space-y-2">
                <button class="inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-700 hover:to-cyan-600 text-white shadow-md hover:shadow-lg focus:ring-indigo-500 px-4 py-2 text-sm w-full">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="lucide lucide-plus-circle h-4 w-4 mr-2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M8 12h8"></path>
                        <path d="M12 8v8"></path>
                    </svg>
                    Add to Configuration
                </button>
                <a href="/component/{{ componentType }}/{{ component.slugify_name }}"
                   class="inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-gradient-to-r from-slate-50 to-white hover:from-indigo-50 hover:to-cyan-50 text-slate-700 hover:text-slate-800 border border-slate-200 hover:border-slate-300 focus:ring-slate-400 shadow-sm hover:shadow px-4 py-2 text-sm w-full">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="lucide lucide-info h-4 w-4 mr-2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M12 16v-4"></path>
                        <path d="M12 8h.01"></path>
                    </svg>
                    View Details
                </a>
            </div>
        </div>
    </div>
{% endfor %}