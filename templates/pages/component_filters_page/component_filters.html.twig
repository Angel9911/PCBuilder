{% extends 'base.html.twig' %}

{% block title %}PC Configuration{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- code for spinner -->
    <div id="loading-spinner" class="loading-spinner hidden">
        <div class="spinner"></div>
    </div>

    <div class="mb-8 flex items-center">
        <div class="mb-8 flex items-center">
            <a href="{{ path('configurator.build') }}"
               class="inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2
              bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-700 hover:to-cyan-600 text-white shadow-md hover:shadow-lg
              px-4 py-2 text-sm group">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="lucide lucide-arrow-left h-5 w-5 mr-2 transition-transform duration-200 group-hover:-translate-x-1"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     viewBox="0 0 24 24">
                    <path d="m12 19-7-7 7-7"></path>
                    <path d="M19 12H5"></path>
                </svg>
                Back to Configurator
            </a>
        </div>
    </div>
    <h2 id="component-data" data-type="{{ componentType }}" class="text-2xl font-bold text-center mb-6 bg-gradient-to-r from-indigo-700 to-cyan-500 bg-clip-text text-transparent">
        {{ componentLabel }}
    </h2>
    <div class="md:flex md:gap-8">
        <div class="md:w-1/4">
            <div class="bg-white rounded-xl shadow-lg p-6 space-y-6 sticky top-8 border border-slate-200">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-lg font-semibold bg-gradient-to-r from-indigo-700 to-cyan-500 bg-clip-text text-transparent">
                        Filters
                    </h2>
                    <button id="clearFilters" type="button"
                            class="inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-gradient-to-r from-slate-50 to-white hover:from-indigo-50 hover:to-cyan-50 text-slate-700 hover:text-slate-800 border border-slate-200 hover:border-slate-300 focus:ring-slate-400 shadow-sm hover:shadow px-4 py-2 text-sm"
                            onclick="clearAllFilters()">
                        Clear all
                    </button>
                </div>

                {% for filter in filters %}
                    <div class="border-b border-slate-200 pb-4 last:border-0">
                        <button type="button"
                                class="w-full flex items-center justify-between py-2 text-left focus:outline-none group"
                                onclick="toggleFilter(this)">
                            <h3 class="text-sm font-medium text-slate-900 group-hover:text-indigo-600 transition-colors">
                                {{ filter.label }}
                            </h3>
                            <svg id="expand-icon" xmlns="http://www.w3.org/2000/svg"
                                 class="lucide lucide-chevron-down h-5 w-5 text-slate-400 group-hover:text-indigo-600 transition-colors"
                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="m6 9 6 6 6-6"></path>
                            </svg>
                        </button>

                        <div class="space-y-2 mt-2 hidden">
                            {% for value in filter.values %}
                                <label class="flex items-center space-x-2 cursor-pointer group">
                                    <input type="checkbox" name="{{ filter.key }}[]" value="{{ value }}"
                                           class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                                    <span class="text-sm text-slate-600 group-hover:text-slate-800">{{ value }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="md:w-3/4 mt-6 md:mt-0">
            <div id="component-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% include 'pages/component_filters_page/component_templates/component_list.html.twig' with {
                    'components': components,
                    'componentType': componentType
                } %}
            </div>
        </div>
    </div>
    <div id="pagination-container">
        {% include 'pages/component_filters_page/component_templates/component_pagination.html.twig' with {
            'totalPages': totalPages,
            'currentPage': currentPage,
            'componentType': componentType
        } %}
    </div>
</div>
{% endblock %}
