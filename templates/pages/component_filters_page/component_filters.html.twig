{% extends 'base.html.twig' %}

{% block title %}PC Configuration{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- code for spinner -->
    <div id="loading-spinner" class="loading-spinner hidden">
        <div class="spinner"></div>
    </div>

    <h2 id="component-data" data-type="{{ componentType }}" class="text-2xl font-bold text-center mb-6 bg-gradient-to-r from-indigo-700 to-cyan-500 bg-clip-text text-transparent">
        {{ componentLabel }}
    </h2>

    <div class="mb-8 flex items-center">
        <div class="mb-8 flex items-center">
            <a href="{{ path('configurator.build') }}"
               class="inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2
              bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-700 hover:to-cyan-600 text-white shadow-md hover:shadow-lg
              px-4 py-2 text-sm group">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="lucide lucide-arrow-left h-5 w-5 mr-2 transition-transform duration-200 group-hover:-translate-x-1"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     viewBox="0 0 24 24">
                    <path d="m12 19-7-7 7-7"></path>
                    <path d="M19 12H5"></path>
                </svg>
                Back to Configurator
            </a>
        </div>
    </div>

    <div class="bg-gradient-to-r bg-gradient-to-br from-indigo-50 via-cyan-50 to-white border-b border-indigo-100">
        <div class="max-w-7xl mx-auto px-4 py-6 sm:py-10">
            <div class="text-center mb-4 sm:mb-6">
                <h2 class="text-lg sm:text-2xl font-semibold sm:font-bold bg-gradient-to-r from-indigo-600 via-blue-600 to-cyan-500 bg-clip-text text-transparent mb-1 sm:mb-2">
                    AI-Powered Hardware Component Finder
                </h2>
                <p class="text-xs sm:text-sm text-gray-600">
                    Describe what you need and let AI find the perfect peripherals for you
                </p>
            </div>

            <!-- AI Input -->
            {% include 'pages/pages_templates/ai_product_finder_section.html.twig' with {
                row_classes: 'max-w-4xl mx-auto flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 bg-white rounded-xl sm:rounded-2xl shadow-lg sm:shadow-2xl border border-indigo-200 p-3 sm:p-4 relative overflow-visible group transition-all duration-300 hover:shadow-indigo-300 focus-within:ring-2 focus-within:ring-cyan-400',
                button_classes: 'bg-gradient-to-r from-indigo-600 to-cyan-600 hover:from-indigo-700 hover:to-cyan-700',
                component_type: componentType,
                endpoint: path('component.ai.recommended', { product: componentType }),
                widget_id: 'ai-components',
                target_id: 'ai-reco-container'
            } %}
        </div>
    </div>

    {# --- AI Recommendations Mount Point --- #}
    <div id="ai-reco-container" class="max-w-7xl mx-auto px-4 mt-6 sm:mt-8"></div>


    <div class="md:flex md:gap-8">
        <div class="md:w-1/4">

            {# in your periphery_filters.html.twig (or components), inside the grid layout #}
            {% include 'pages/pages_templates/new_product_filter_section.html.twig' with { filters: filters, componentType: componentType } %}

        </div>
        <div class="md:w-3/4 mt-6 md:mt-0">
            <div id="component-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% include 'pages/component_filters_page/component_templates/component_list.html.twig' with {
                    'components': components,
                    'componentType': componentType
                } %}
            </div>
        </div>
    </div>
    <div id="pagination-container">
        {% include 'pages/component_filters_page/component_templates/component_pagination.html.twig' with {
            'totalPages': totalPages,
            'currentPage': currentPage,
            'componentType': componentType
        } %}
    </div>
</div>
{% endblock %}
