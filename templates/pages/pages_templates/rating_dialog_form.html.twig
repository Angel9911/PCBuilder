<div id="ratingModal"
     class="hidden fixed inset-0 z-50 bg-black bg-opacity-60 backdrop-blur-sm flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md relative">
        <!-- Close button -->
        <button type="button"
                id="closeRatingModal"
                class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>

        <form id="ratingForm" class="p-6 space-y-4">
            <h3 id="ratingModalTitle"
                class="text-xl font-bold text-gray-900 mb-4 text-center">
                Rate This Item
            </h3>

            <!-- Star rating -->
            <div class="flex justify-center mb-6" id="modalStars">
                {% for i in 1..5 %}
                    <button type="button"
                            class="modal-star-btn transition-all duration-200 transform hover:scale-110 focus:outline-none mx-1"
                            data-value="{{ i }}">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             class="lucide lucide-star w-8 h-8 transition-all duration-200 text-gray-300 hover:text-yellow-300">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14
                                18.18 21.02 12 17.77 5.82 21.02
                                7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                    </button>
                {% endfor %}
            </div>

            <!-- Inputs -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
                    <input type="text" name="name"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                           placeholder="Your name" required>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                    <input type="email" name="email"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                           placeholder="your@email.com" required>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Comment (Optional)</label>
<textarea name="comment" rows="3"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none"
          placeholder="Share your thoughts..."></textarea>
            </div>

            <!-- Actions -->
            <div class="flex justify-end space-x-3 mt-6">
                <button type="button" id="cancelRatingModal"
                        class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                    Cancel
                </button>
                <button type="submit"
                        id="submitRating"
                        class="px-4 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-lg hover:from-indigo-700 hover:to-purple-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all"
                        disabled>
                    Submit Rating
                </button>
            </div>
        </form>
    </div>
</div>
