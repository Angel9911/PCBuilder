{# Wrapper + Header #}
<div class="relative bg-gradient-to-br from-indigo-50/80 via-purple-50/60 to-cyan-50/80 rounded-2xl p-1 shadow-xl border border-indigo-200/50 backdrop-blur-sm">
    <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-indigo-400 via-purple-500 to-cyan-400 opacity-20 animate-pulse"></div>

    <div class="relative bg-white/90 backdrop-blur-sm rounded-xl p-6 border border-white/50">

        {# Top banner: title + based-on #}
        <div class="bg-gradient-to-r from-indigo-100/80 via-purple-100/60 to-cyan-100/80 rounded-xl p-6 mb-8 border border-indigo-300/50 relative overflow-hidden">
            <div class="absolute inset-0 opacity-10">
                <div class="absolute top-0 left-0 w-32 h-32 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-full blur-3xl"></div>
                <div class="absolute bottom-0 right-0 w-24 h-24 bg-gradient-to-br from-purple-500 to-cyan-500 rounded-full blur-2xl"></div>
            </div>

            <div class="relative z-10">
                <div class="flex items-center gap-3 mb-3">
                    <div class="p-3 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-full shadow-lg">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="lucide lucide-sparkles w-6 h-6 text-white animate-pulse" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
                            <path d="M5 3v4"></path>
                            <path d="M19 17v4"></path>
                            <path d="M3 5h4"></path>
                            <path d="M17 19h4"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-2xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
                            AI Recommendations</h3>
                        <p class="text-sm text-indigo-700/80 font-medium">Based on:
                            <span id="ai-based-on-text">"{{ user_query|default('') }}"</span>
                        </p>
                    </div>
                </div>

                <div class="bg-white/80 rounded-lg p-4 border border-indigo-200/50 shadow-sm">
                    <p class="text-sm text-indigo-900 font-medium">
                        Found {{ components|length }} product{{ components|length == 1 ? '' : 's' }} that match your
                        requirements. Products are ranked by AI compatibility score.
                    </p>
                </div>
            </div>
        </div>

        {# Grid of cards #}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

            {% for component in components %}

                {# {% set main_image = periphery.image_url|default('/assets/images/placeholder_product.jpg') %}  #}

                {# Rank-based accent (matches your design) #}
                {% set isFirst  = loop.first %}
                {% set isSecond = loop.index == 2 %}
                {% set isThird  = loop.index == 3 %}

                {% set ringClass =
                    isFirst  ? 'shadow-2xl shadow-yellow-500/30 ring-4 ring-yellow-400/50' :
                    (isSecond ? 'shadow-xl shadow-gray-400/20 ring-2 ring-gray-400/30' :
                    (isThird  ? 'shadow-xl shadow-amber-600/20 ring-2 ring-amber-400/30' : 'shadow-sm')) %}

                {% set hoverGlow =
                    isFirst  ? 'from-yellow-400 via-yellow-500 to-yellow-600' :
                    (isSecond ? 'from-gray-400 via-gray-500 to-gray-600' :
                    (isThird  ? 'from-amber-400 via-amber-500 to-amber-600' : 'from-indigo-500 via-purple-500 to-cyan-500')) %}

                <div class="relative transform transition-all duration-700 translate-y-0 opacity-100 scale-100"
                     style="transition-delay: {{ (loop.index0 * 100) }}ms;">
                    {# Corner badge (crown/medal/trophy) #}
                    <div class="absolute -top-3 -left-3 z-20">
                        {% if isFirst %}
                            <div class="flex items-center justify-center w-12 h-12 rounded-full shadow-lg border-2 border-white bg-gradient-to-r from-yellow-400 to-yellow-600">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="lucide lucide-crown w-6 h-6 text-yellow-500" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2">
                                    <path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"></path>
                                </svg>
                            </div>
                        {% elseif isSecond %}
                            <div class="flex items-center justify-center w-12 h-12 rounded-full shadow-lg border-2 border-white bg-gradient-to-r from-gray-300 to-gray-500">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="lucide lucide-medal w-6 h-6 text-gray-400" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2">
                                    <path d="M7.21 15 2.66 7.14a2 2 0 0 1 .13-2.2L4.4 2.8A2 2 0 0 1 6 2h12a2 2 0 0 1 1.6.8l1.6 2.14a2 2 0 0 1 .14 2.2L16.79 15"></path>
                                    <path d="M11 12 5.12 2.2"></path>
                                    <path d="m13 12 5.88-9.8"></path>
                                    <path d="M8 7h8"></path>
                                    <circle cx="12" cy="17" r="5"></circle>
                                    <path d="M12 18v-2h-.5"></path>
                                </svg>
                            </div>
                        {% elseif isThird %}
                            <div class="flex items-center justify-center w-12 h-12 rounded-full shadow-lg border-2 border-white bg-gradient-to-r from-amber-400 to-amber-600">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="lucide lucide-trophy w-6 h-6 text-amber-600" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2">
                                    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                                    <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                                    <path d="M4 22h16"></path>
                                    <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                                    <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                                    <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
                                </svg>
                            </div>
                        {% endif %}
                    </div>

                    {# Match pill (top-right) #}
                    {% if component.ai_matching is defined %}
                        <div class="absolute top-3 right-3 z-20">
                            <div class="bg-gradient-to-r from-green-500 to-emerald-600 text-white px-3 py-1.5 rounded-full text-xs font-bold shadow-lg border border-white/50">
                                {{ component.ai_matching }}% Match
                            </div>
                        </div>
                    {% endif %}

                    <div class="
            bg-white rounded-xl overflow-hidden group relative
            transition-all duration-500 hover:scale-105
            {{ ringClass }}
          ">
                        <div class="
              absolute inset-0 rounded-xl opacity-0 group-hover:opacity-100
              transition-opacity duration-500 pointer-events-none
              bg-gradient-to-r {{ hoverGlow }}
              animate-pulse
            ">
                            <div class="absolute inset-[2px] rounded-xl bg-white"></div>
                        </div>

                        <div class="relative z-10">
                            {# Image + ribbons #}
                            <div class="relative">
                                <img src="{{ component.image_url ?: 'https://images.pexels.com/photos/1432675/pexels-photo-1432675.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1' }}"
                                     alt="{{ component.name }}"
                                     class="w-full h-40 sm:h-48 object-cover group-hover:scale-105 transition-transform duration-300">

                                {% if isFirst %}
                                    <div class="absolute inset-0 bg-gradient-to-t from-yellow-500/30 to-transparent">
                                        <div class="absolute bottom-3 left-3 right-3">
                                            <div class="bg-yellow-500/95 text-white px-2 py-1 rounded-full text-xs font-bold text-center animate-pulse">
                                                🏆 BEST MATCH
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                {% if component.promo is defined and component.promo %}
                                    <div class="absolute top-3 left-3 bg-gradient-to-r from-red-500 to-red-600 text-white px-3 py-1 rounded-lg shadow-xl transform -rotate-3 hover:rotate-0 transition-transform duration-300">
                                        <span class="text-sm font-bold">PROMO</span>
                                    </div>
                                {% endif %}

                                {# Always show IN STOCK bottom-left for this AI section #}
                                <div class="absolute bottom-3 left-3 px-3 py-1.5 rounded-lg shadow-lg text-xs font-bold bg-gradient-to-r from-green-500 to-green-600 text-white border border-white/50">
                                    IN STOCK
                                </div>
                            </div>

                            <div class="p-6">
                                {# AI note block #}
                                {% if component.ai_description is defined %}
                                    <div class="mb-4 p-3 rounded-lg border-2
                      {{ isFirst ? 'bg-gradient-to-r from-yellow-50 to-amber-50 border-yellow-200'
                                    : 'bg-gradient-to-r from-indigo-50 to-purple-50 border-indigo-200' }}">
                                        <div class="flex items-start gap-2">
                                            <div class="p-1 rounded-full {{ isFirst ? 'bg-yellow-200' : 'bg-indigo-200' }}">
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                     class="lucide lucide-sparkles w-3 h-3 {{ isFirst ? 'text-yellow-700' : 'text-indigo-700' }}"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2">
                                                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <p class="text-xs font-bold mb-1 {{ isFirst ? 'text-yellow-800' : 'text-indigo-800' }}">
                                                    {{ isFirst ? '🏆 TOP AI RECOMMENDATION:' : '🤖 AI MATCH #' ~ loop.index ~ ':' }}
                                                </p>
                                                <p class="text-xs leading-relaxed {{ isFirst ? 'text-yellow-700' : 'text-indigo-700' }}">
                                                    {{ component.ai_description }}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                <!-- Title + Price -->
                                <div>
                                    <h3 class="text-lg font-bold bg-gradient-to-r from-indigo-700 to-cyan-600 bg-clip-text text-transparent leading-tight group-hover:from-purple-600 group-hover:to-indigo-600 transition-all duration-300 mb-2">
                                        {{ component.name }}
                                    </h3>
                                    <div class="flex items-center gap-2">
                                        <div class="bg-gradient-to-r from-emerald-500 to-green-600 text-white px-3 py-1 rounded-full shadow-lg">
                                            <span class="text-lg font-bold">$589.99</span>
                                        </div>
                                        <div class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded-full">Best Price</div>
                                    </div>
                                </div>

                                {# ---------------- Performance Scores ---------------- #}
                                {% if component.specifications_scores is defined and component.specifications_scores|length > 0 %}
                                    <div class="space-y-2 js-score-root">
                                        <div class="grid grid-cols-1 gap-3">
                                            {% for scoreLabel, scoreValue in component.specifications_scores %}
                                                <div class="relative group/score bg-gray-50 rounded-lg p-3 hover:bg-gray-100 transition-colors duration-200 score-item"
                                                     data-score="{{ scoreValue|default(0) }}"
                                                     data-label="{{ scoreLabel }}">
                                                    <div class="flex items-center justify-between mb-1">
                                                        <div class="flex items-center gap-2">
                                                            <div class="p-1 bg-indigo-100 rounded text-indigo-600">
                                                                {% if scoreLabel == 'Gaming Score' %}
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-monitor w-4 h-4"><rect width="20" height="14" x="2" y="3" rx="2"></rect><line x1="8" x2="16" y1="21" y2="21"></line><line x1="12" x2="12" y1="17" y2="21"></line></svg>
                                                                {% elseif scoreLabel == 'Future Proofing' %}
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap w-4 h-4"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                                                                {% else %}
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cpu w-4 h-4"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M15 2v2"></path><path d="M15 20v2"></path><path d="M2 15h2"></path><path d="M2 9h2"></path><path d="M20 15h2"></path><path d="M20 9h2"></path><path d="M9 2v2"></path><path d="M9 20v2"></path></svg>
                                                                {% endif %}
                                                            </div>
                                                            <span class="text-sm font-medium text-gray-700 score-label">{{ scoreLabel }}</span>
                                                        </div>

                                                        <div class="flex items-center gap-2">
                                                            <div class="text-lg font-bold bg-white px-2 py-1 rounded-lg shadow-sm score-value">
                                                                {{ scoreValue|default(0) }}
                                                            </div>
                                                            <div class="text-xs text-gray-500">/100</div>
                                                        </div>
                                                    </div>
                                                    {% set score = scoreValue|default(0) %}
                                                    {% if score < 0 %}
                                                        {% set score = 0 %}
                                                    {% elseif score > 100 %}
                                                        {% set score = 100 %}
                                                    {% endif %}
                                                    <div class="relative">
                                                        <div class="h-2 bg-white rounded-full overflow-hidden shadow-inner">
                                                            <div class="h-full transition-all duration-1000 ease-out relative group-hover/score:shadow-lg origin-left score-bar"
                                                                 style="width: {{ score }}%;">
                                                                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/50 to-transparent animate-[shimmer_2s_linear_infinite]"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}

                                <!-- Specs (non-score) -->
                                <div class="space-y-2">
                                    <div class="grid grid-cols-1 gap-1">
                                        {% for label, value in component.specifications %}
                                            <div class="flex items-center text-sm text-gray-600 hover:text-gray-800 transition-colors duration-200 py-1">
                                                <div class="p-1 bg-blue-100 rounded text-blue-600 flex-shrink-0 mr-2 w-6 h-6 flex items-center justify-center">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cpu w-4 h-4"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M15 2v2"></path><path d="M15 20v2"></path><path d="M2 15h2"></path><path d="M2 9h2"></path><path d="M20 15h2"></path><path d="M20 9h2"></path><path d="M9 2v2"></path><path d="M9 20v2"></path></svg>                                    </div>
                                                <span class="font-medium text-gray-700">{{ label }}:</span>
                                                <span class="ml-1 font-semibold text-gray-900">{{ value }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="space-y-2 pt-1">
                                    <button class="add-to-config-btn w-full bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-700 hover:to-cyan-600 text-white px-4 py-2 rounded-lg font-medium transition-all duration-200 flex items-center justify-center gap-2 shadow-md hover:shadow-lg transform hover:scale-105"
                                            data-component-name="{{ component.slugify_name }}"
                                            data-component-type="{{ component.product_type }}">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                             class="lucide lucide-plus w-4 h-4"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                                        Add to Configuration
                                    </button>
                                    <a href="/product/{{ component.product_type }}/{{ component.slugify_name }}"
                                       class="w-full bg-gradient-to-r from-gray-50 to-white hover:from-indigo-50 hover:to-cyan-50 text-gray-700 hover:text-gray-800 px-4 py-1.5 rounded-lg font-medium transition-all duration-200 flex items-center justify-center gap-2 border border-gray-200 hover:border-gray-300 shadow-sm hover:shadow text-sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                             class="lucide lucide-info w-4 h-4"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}

        </div>
    </div>
</div>